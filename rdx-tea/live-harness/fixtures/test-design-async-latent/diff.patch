+use tokio::task::JoinHandle;
+
+struct Runner {
+    handle: Option<JoinHandle<()>>,
+}
+
+impl Runner {
+    async fn run(&mut self) -> Result<(), String> {
+        let h = tokio::spawn(async {
+            for _ in 0..100 {
+                tokio::task::yield_now().await;
+            }
+        });
+        self.handle = Some(h);
+        match self.handle.take() {
+            Some(j) => j.await.map_err(|e| format!("{e:?}")),
+            None => Ok(()),
+        }
+    }
+}
