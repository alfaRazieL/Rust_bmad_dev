{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alfaRazieL/Rust_bmad_dev/rdx-tea-integration/rdx-tea/live-harness/schemas/live-evidence.v2.schema.json",
  "title": "rdx-tea live evidence bundle v2 (arm-aware)",
  "description": "D3.3.2 §7 arm-aware evidence contract. Baseline and candidate branches have different requirements — a baseline bundle carrying an RDX bundle hash or wrapper invocation is rejected; a candidate bundle without a sidecar or verifier PASS is rejected. Only structured signals are accepted; free-text Skill mentions are not admissible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arm",
    "scenario",
    "workflow",
    "repetition",
    "run_id",
    "run_id_handshake",
    "workspace",
    "identity",
    "runtime",
    "invocation",
    "artifacts",
    "hashes",
    "observation",
    "cleanup"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "rdx-tea-live-evidence.v2"},
    "arm": {"type": "string", "enum": ["baseline", "candidate"]},
    "scenario": {
      "type": "string",
      "enum": [
        "test-design-async",
        "atdd-api-async",
        "atdd-api-async-corrected",
        "docs-only-rust-repo"
      ]
    },
    "workflow": {"type": "string", "enum": ["test-design", "atdd"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 20},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{4,80}$"},
    "run_id_handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "mismatch"],
      "properties": {
        "schedule": {"type": "string"},
        "invocation_json": {"type": ["string", "null"]},
        "workspace_runtime_dir": {"type": ["string", "null"]},
        "run_report": {"type": ["string", "null"]},
        "mismatch": {"type": "boolean"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "config_dir", "config_dir_hash", "fixture_hash"],
      "properties": {
        "path": {"type": "string"},
        "config_dir": {"type": "string"},
        "config_dir_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude_code_path",
        "expected_surface",
        "observed_surface",
        "surface_diff",
        "contamination",
        "timeout_seconds",
        "max_budget_usd"
      ],
      "properties": {
        "claude_code_path": {"type": "string"},
        "expected_surface": {"type": "object"},
        "observed_surface": {
          "type": "object",
          "required": [
            "claude_code_version",
            "model",
            "permission_mode",
            "tools",
            "skills",
            "slash_commands",
            "mcp_servers",
            "plugins",
            "memory_paths",
            "session_id",
            "init_event_seen"
          ],
          "properties": {
            "claude_code_version": {"type": "string"},
            "model": {"type": "string"},
            "permission_mode": {"type": "string"},
            "tools": {"type": "array", "items": {"type": ["string", "null"]}},
            "skills": {"type": "array", "items": {"type": ["string", "null"]}},
            "slash_commands": {"type": "array"},
            "mcp_servers": {"type": "array"},
            "plugins": {"type": "array"},
            "memory_paths": {"type": "array"},
            "session_id": {"type": "string"},
            "init_event_seen": {"type": "boolean"}
          }
        },
        "surface_diff": {"type": "object"},
        "contamination": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 30},
        "max_budget_usd": {"type": "number", "minimum": 0}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_hash", "prompt_hash", "started_at", "finished_at",
                    "exit_code", "reason"],
      "properties": {
        "command_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "exit_code": {"type": "integer"},
        "reason": {"type": "string", "enum": ["normal", "timeout", "runtime_error", "aborted"]}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_artefacts"],
      "properties": {
        "new_artefacts": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_report", "transcript", "bundle"],
      "properties": {
        "run_report": {"type": "string"},
        "transcript": {"type": "string"},
        "bundle": {"type": "string"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_mode",
        "observed_mode_basis",
        "wrapper_skill_invoked",
        "child_skill_invoked",
        "task_tool_use_count",
        "transcript_sha256",
        "session_id"
      ],
      "properties": {
        "observed_mode": {
          "type": "string",
          "enum": [
            "OBSERVED_SEQUENTIAL",
            "OBSERVED_SUBAGENT",
            "TRANSCRIPT_MISSING",
            "TRANSCRIPT_INVALID",
            "INFERRED_ABSENT"
          ]
        },
        "observed_mode_basis": {
          "type": "string",
          "enum": [
            "no-subagent-events-surrogate",
            "direct-subagent-event",
            "transcript-missing",
            "transcript-invalid",
            "pending-reconciliation"
          ]
        },
        "wrapper_skill_invoked": {"type": "boolean"},
        "child_skill_invoked": {"type": "boolean"},
        "task_tool_use_count": {"type": "integer", "minimum": 0},
        "transcript_sha256": {"type": "string"},
        "session_id": {"type": "string"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observed"],
      "properties": {
        "state": {"type": "string", "enum": ["FINALIZED", "ABORTED", "FAILED"]},
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lock_state", "overlay_state", "run_dir_retained",
                        "transcript_retained"],
          "properties": {
            "lock_state": {"type": "string",
                             "enum": ["absent", "owned-still-present",
                                       "foreign-present"]},
            "overlay_state": {"type": "string",
                                "enum": ["absent", "rdx-owned-still-present",
                                          "foreign-preserved"]},
            "run_dir_retained": {"type": "boolean"},
            "transcript_retained": {"type": "boolean"}
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapper_skill_invoked",
        "direct_child_skill_invoked",
        "rdx_bundle_absent",
        "rdx_sidecars_absent",
        "rdx_overlay_absent"
      ],
      "properties": {
        "wrapper_skill_invoked": {"const": false},
        "direct_child_skill_invoked": {"type": "boolean"},
        "rdx_bundle_absent": {"const": true},
        "rdx_sidecars_absent": {"const": true},
        "rdx_overlay_absent": {"const": true}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapper_skill_invoked",
        "child_skill_invoked",
        "sidecars",
        "active_packs",
        "expected_rp_ids",
        "verifier_all_pass",
        "bundle_present"
      ],
      "properties": {
        "wrapper_skill_invoked": {"type": "boolean"},
        "child_skill_invoked": {"type": "boolean"},
        "sidecars": {"type": "array", "items": {"type": "string"},
                       "uniqueItems": true},
        "active_packs": {"type": "array", "items": {"type": "string"}},
        "expected_rp_ids": {"type": "array", "items": {"type": "string"}},
        "verifier_all_pass": {"type": "boolean"},
        "bundle_present": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"arm": {"const": "baseline"}}, "required": ["arm"]},
      "then": {"required": ["baseline"], "not": {"required": ["candidate"]}}
    },
    {
      "if": {"properties": {"arm": {"const": "candidate"}}, "required": ["arm"]},
      "then": {"required": ["candidate"], "not": {"required": ["baseline"]}}
    }
  ]
}
