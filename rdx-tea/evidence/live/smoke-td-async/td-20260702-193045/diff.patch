+++ b/src/lib.rs
@@ -0,0 +1,18 @@
+use tokio::task::JoinHandle;
+
+pub struct Runner {
+    handle: Option<JoinHandle<()>>,
+}
+
+impl Runner {
+    pub async fn run(&mut self) -> Result<(), String> {
+        let h = tokio::spawn(async {
+            // long-running background work
+            for _ in 0..100 {
+                tokio::task::yield_now().await;
+            }
+        });
+        self.handle = Some(h);
+        Ok(())
+    }
+}
