{
  "cli": "/opt/homebrew/bin/claude",
  "default_model_policy": {
    "allowed": [
      "claude-haiku-4-5-20251001",
      "claude-sonnet-4-6"
    ],
    "forbidden": [
      "claude-opus-4-7",
      "opus"
    ],
